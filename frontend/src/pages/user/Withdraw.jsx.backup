import { useState, useEffect } from 'react';

export default function Withdraw() {
  const [amount, setAmount] = useState('');
  const [loading, setLoading] = useState(false);
  const [withdrawalMode, setWithdrawalMode] = useState('automatic');
  const [loadingMode, setLoadingMode] = useState(true);
  const [userProfile, setUserProfile] = useState(null);
  const [showSuccessModal, setShowSuccessModal] = useState(false);
  const [message, setMessage] = useState('');

  useEffect(() => {
    fetchWithdrawalMode();
    fetchUserProfile();
  }, []);

  const fetchWithdrawalMode = async () => {
    try {
      const response = await fetch('https://avenza.live/api/settings/withdrawal-mode');
      const data = await response.json();
      if (data.success) {
        setWithdrawalMode(data.mode);
      }
    } catch (error) {
      console.error('Failed to fetch withdrawal mode:', error);
    } finally {
      setLoadingMode(false);
    }
  };

  const fetchUserProfile = async () => {
    try {
      const token = localStorage.getItem('token');
      
      // First check localStorage for wallet (from login session)
      const userData = JSON.parse(localStorage.getItem('user') || '{}');
      
      const response = await fetch('https://avenza.live/api/user/profile', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      
      if (response.ok) {
        const data = await response.json();
        
        // Use wallet from localStorage as fallback
        if (!data.wallet_address && userData.wallet_address) {
          data.wallet_address = userData.wallet_address;
          data.wallet_type = userData.wallet_type;
        }
        
        setUserProfile(data);
      }
    } catch (error) {
      console.error('Failed to fetch profile:', error);
    }
  };

  const handleWithdraw = async (e) => {
    e.preventDefault();

    if (!amount || parseFloat(amount) <= 0) {
      setMessage('❌ Please enter a valid amount');
      setTimeout(() => setMessage(''), 3000);
      return;
    }

    // Check if wallet is connected for withdrawals
    if (!userProfile?.wallet_address) {
      setMessage('❌ Please connect your wallet in Profile page first');
      setTimeout(() => setMessage(''), 5000);
      return;
    }

    setLoading(true);

    try {
      const token = localStorage.getItem('token');
      const response = await fetch('https://avenza.live/api/withdraw', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({
          amount: parseFloat(amount),
          wallet_type: 'avenza'
        })
      });

      const data = await response.json();

      if (response.ok && data.success) {
        setShowSuccessModal(true);
        setAmount('');
        fetchUserProfile(); // Refresh balance
      } else {
        setMessage(`❌ ${data.detail || data.message || 'Withdrawal failed'}`);
        setTimeout(() => setMessage(''), 3000);
      }
    } catch (error) {
      console.error('Withdrawal error:', error);
      setMessage('❌ Failed to process withdrawal');
      setTimeout(() => setMessage(''), 3000);
    } finally {
      setLoading(false);
    }
  };

  if (loadingMode) {
    return (
      <div style={{
        display: 'flex',
        justifyContent: 'center',
        alignItems: 'center',
        minHeight: '400px'
      }}>
        <p style={{ color: '#94a3b8', fontSize: '16px' }}>Loading...</p>
      </div>
    );
  }

  // If user hasn't connected wallet
  if (!userProfile?.wallet_address) {
    return (
      <div style={{
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        justifyContent: 'center',
        minHeight: '60vh',
        padding: '20px'
      }}>
        <div style={{
          textAlign: 'center',
          background: 'linear-gradient(135deg, rgba(239,68,68,0.1), rgba(220,38,38,0.05))',
          border: '1px solid rgba(239,68,68,0.3)',
          borderRadius: '24px',
          padding: '60px 40px',
          maxWidth: '500px',
          width: '100%'
        }}>
          <div style={{ fontSize: '64px', marginBottom: '20px' }}>⚠️</div>
          <h1 style={{
            fontSize: '24px',
            fontWeight: 'bold',
            color: '#fff',
            margin: '0 0 16px 0'
          }}>
            Wallet Not Connected
          </h1>
          <p style={{
            fontSize: '16px',
            color: '#94a3b8',
            marginBottom: '24px',
            lineHeight: '1.6'
          }}>
            Please connect your wallet to enable withdrawals.
          </p>
          <button
            onClick={() => window.location.href = '/profile'}
            style={{
              background: 'linear-gradient(135deg, #4a90e2, #357abd)',
              border: 'none',
              borderRadius: '12px',
              padding: '14px 32px',
              color: '#fff',
              fontSize: '16px',
              fontWeight: '600',
              cursor: 'pointer'
            }}
          >
            Go to Profile
          </button>
        </div>
      </div>
    );
  }

  return (
    <div style={{ padding: '20px', maxWidth: '600px', margin: '0 auto' }}>
      {/* Success Modal */}
      {showSuccessModal && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          backgroundColor: 'rgba(0, 0, 0, 0.7)',
          display: 'flex',
          justifyContent: 'center',
          alignItems: 'center',
          zIndex: 9999
        }}>
          <div style={{
            background: 'linear-gradient(135deg, #1e293b, #0f172a)',
            border: '1px solid rgba(74, 144, 226, 0.3)',
            borderRadius: '16px',
            padding: '32px',
            maxWidth: '400px',
            width: '90%',
            textAlign: 'center'
          }}>
            <div style={{ fontSize: '64px', marginBottom: '16px' }}>✅</div>
            <h3 style={{
              color: '#fff',
              fontSize: '20px',
              fontWeight: 'bold',
              marginBottom: '12px'
            }}>
              Request Submitted
            </h3>
            <p style={{
              color: '#94a3b8',
              fontSize: '14px',
              marginBottom: '8px'
            }}>
              Your withdrawal request has been submitted successfully.
            </p>
            <div style={{
              background: 'rgba(74, 144, 226, 0.1)',
              border: '1px solid rgba(74, 144, 226, 0.3)',
              borderRadius: '8px',
              padding: '12px',
              marginBottom: '20px',
              marginTop: '16px'
            }}>
              <p style={{ color: '#94a3b8', fontSize: '13px', margin: '0 0 4px 0' }}>
                Amount: <strong style={{ color: '#10b981' }}>${amount}</strong>
              </p>
              <p style={{ color: '#94a3b8', fontSize: '13px', margin: 0 }}>
                To: <strong style={{ color: '#4a90e2' }}>{userProfile.wallet_address.slice(0, 10)}...</strong>
              </p>
            </div>
            <button
              onClick={() => setShowSuccessModal(false)}
              style={{
                background: 'linear-gradient(135deg, #4a90e2, #357abd)',
                border: 'none',
                borderRadius: '8px',
                padding: '12px 32px',
                color: '#fff',
                fontSize: '14px',
                fontWeight: '600',
                cursor: 'pointer',
                width: '100%'
              }}
            >
              OK
            </button>
          </div>
        </div>
      )}

      {/* Header */}
      <div style={{
        background: 'linear-gradient(135deg, rgba(74,144,226,0.2), rgba(147,51,234,0.1))',
        border: '1px solid rgba(74,144,226,0.3)',
        borderRadius: '20px',
        padding: '32px',
        marginBottom: '24px'
      }}>
        <h1 style={{
          fontSize: '28px',
          fontWeight: 'bold',
          color: '#fff',
          margin: '0 0 8px 0'
        }}>
          💸 Withdraw Funds
        </h1>
        <p style={{ color: '#94a3b8', fontSize: '14px', margin: 0 }}>
          Withdraw from your AVENZA wallet
        </p>
      </div>

      {message && (
        <div style={{
          background: message.includes('✅') ? 'rgba(16,185,129,0.1)' : 'rgba(239,68,68,0.1)',
          border: `1px solid ${message.includes('✅') ? 'rgba(16,185,129,0.3)' : 'rgba(239,68,68,0.3)'}`,
          borderRadius: '12px',
          padding: '12px 16px',
          marginBottom: '24px',
          color: message.includes('✅') ? '#10b981' : '#ef4444',
          fontSize: '14px'
        }}>
          {message}
        </div>
      )}

      {/* Withdrawal Form */}
      <div style={{
        background: 'linear-gradient(135deg, #1e293b, #0f172a)',
        border: '1px solid rgba(74,144,226,0.3)',
        borderRadius: '16px',
        padding: '24px'
      }}>
        <form onSubmit={handleWithdraw}>
          {/* Balance */}
          <div style={{ marginBottom: '20px' }}>
            <label style={{
              color: '#94a3b8',
              fontSize: '13px',
              fontWeight: '600',
              display: 'block',
              marginBottom: '8px'
            }}>
              Available Balance
            </label>
            <div style={{
              background: 'rgba(74, 144, 226, 0.1)',
              border: '1px solid rgba(74, 144, 226, 0.3)',
              borderRadius: '12px',
              padding: '16px',
              color: '#10b981',
              fontSize: '24px',
              fontWeight: 'bold'
            }}>
              ${userProfile?.avenza_balance ? parseFloat(userProfile.avenza_balance).toFixed(2) : '0.00'}
            </div>
          </div>

          {/* Amount Input */}
          <div style={{ marginBottom: '20px' }}>
            <label style={{
              color: '#94a3b8',
              fontSize: '13px',
              fontWeight: '600',
              display: 'block',
              marginBottom: '8px'
            }}>
              Withdrawal Amount
            </label>
            <input
              type="number"
              step="0.01"
              value={amount}
              onChange={(e) => setAmount(e.target.value)}
              placeholder="Enter amount"
              required
              style={{
                width: '100%',
                background: 'rgba(30, 41, 59, 0.5)',
                border: '1px solid rgba(100, 116, 139, 0.3)',
                borderRadius: '12px',
                padding: '14px',
                color: '#fff',
                fontSize: '16px',
                outline: 'none'
              }}
            />
          </div>

          {/* Wallet Info */}
          <div style={{
            background: 'rgba(74, 144, 226, 0.1)',
            border: '1px solid rgba(74, 144, 226, 0.3)',
            borderRadius: '12px',
            padding: '16px',
            marginBottom: '24px'
          }}>
            <p style={{
              color: '#94a3b8',
              fontSize: '13px',
              margin: '0 0 8px 0',
              fontWeight: '600'
            }}>
              📍 Funds will be sent to:
            </p>
            <div style={{
              background: 'rgba(30, 41, 59, 0.5)',
              border: '1px solid rgba(100, 116, 139, 0.3)',
              borderRadius: '8px',
              padding: '12px'
            }}>
              <p style={{
                color: '#fff',
                fontSize: '14px',
                margin: '0 0 4px 0',
                fontWeight: '600'
              }}>
                ✅ Your Connected Wallet
              </p>
              <p style={{
                color: '#94a3b8',
                fontSize: '12px',
                margin: '0 0 4px 0'
              }}>
                Type: {userProfile?.wallet_type || 'Unknown'}
              </p>
              <p style={{
                color: '#4a90e2',
                fontSize: '12px',
                margin: 0,
                wordBreak: 'break-all'
              }}>
                {userProfile?.wallet_address}
              </p>
            </div>
          </div>

          {/* Submit Button */}
          <button
            type="submit"
            disabled={loading}
            style={{
              width: '100%',
              background: loading ? 'rgba(74, 144, 226, 0.5)' : 'linear-gradient(135deg, #4a90e2, #357abd)',
              border: 'none',
              borderRadius: '12px',
              padding: '16px',
              color: '#fff',
              fontSize: '16px',
              fontWeight: 'bold',
              cursor: loading ? 'not-allowed' : 'pointer',
              transition: 'all 0.2s'
            }}
          >
            {loading ? 'Processing...' : withdrawalMode === 'manual' ? 'Request Withdrawal' : 'Withdraw Now'}
          </button>
        </form>
      </div>
    </div>
  );
}

